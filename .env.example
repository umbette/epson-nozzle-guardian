EPSON_HOST=192.168.1.181
EPSON_PORT=631
EPSON_USE_TLS=true
INACTIVITY_DAYS=5
AUTO_PURGE_ENABLED=false
# API Authentication: leave blank to automatically generate a secure 32-byte secret in ./data/api_key.secret
API_KEY=
# Set to true only if you want unauthenticated local access (not recommended)
ALLOW_UNAUTHENTICATED=false
