<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local LAN printers commonly expose IPP/EWS over plain HTTP on port 631 or 80 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
